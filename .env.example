# ==========================================
# PostPilot Environment Configuration
# ==========================================

# Database (PostgreSQL)
# Local: postgresql://postpilot:postpilot_secret@localhost:5432/postpilot?schema=public
# Docker: postgresql://postpilot:postpilot_secret@postgres:5432/postpilot?schema=public
DATABASE_URL="postgresql://postpilot:postpilot_secret@localhost:5432/postpilot?schema=public"

# Redis Queue (BullMQ)
# Local: redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL="redis://localhost:6379"

# NextAuth / Session Secret
NEXTAUTH_SECRET="f39e8a7192bc58d4a3e218c991b8d27039a04f260381628d01b17a1d74659b92"
NEXTAUTH_URL="http://localhost:3000"

# Token Encryption Key (32-byte hex for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# TikTok Developer App Credentials (v2 Content Posting API)
TIKTOK_CLIENT_ID="mock_tiktok_client_key"
TIKTOK_CLIENT_SECRET="mock_tiktok_client_secret"
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"

# Storage Configuration ('local' or 's3')
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"

# Optional MinIO / S3 Configuration
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ROOT_USER="postpilot_minio"
MINIO_ROOT_PASSWORD="postpilot_minio_secret"
AWS_BUCKET="postpilot-videos"
